{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "JVM GC Pause (Connect CDC / S3)",
      "targets": [
        {
          "expr": "rate(jvm_gc_collection_seconds_sum{service=~\"connect-cdc|connect-s3\", pipeline=~\"$pipeline\"}[1m])",
          "legendFormat": "{{service}} {{gc}}",
          "refId": "A"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "Consumer Lag (kafka-exporter)",
      "targets": [
        {
          "expr": "sum by (consumergroup, topic, pipeline) (kafka_consumergroup_lag{pipeline=~\"$pipeline\"})",
          "legendFormat": "{{pipeline}} {{consumergroup}} / {{topic}}",
          "refId": "A"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "title": "JVM Heap Used (Kafka / Connect)",
      "targets": [
        {
          "expr": "jvm_memory_bytes_used{area=\"heap\", service=~\"kafka|connect-cdc|connect-s3\", pipeline=~\"$pipeline\"}",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "title": "Postgres Exporter Up / DB Size",
      "targets": [
        {
          "expr": "pg_up{pipeline=~\"$pipeline\"}",
          "legendFormat": "pg_up ({{pipeline}})",
          "refId": "A"
        },
        {
          "expr": "pg_database_size_bytes{pipeline=~\"$pipeline\"}",
          "legendFormat": "db_size {{datname}}",
          "refId": "B"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 5,
      "title": "Connect Source / Sink Record Rate",
      "targets": [
        {
          "expr": "rate(kafka_connect_source_task_source_record_poll_total{pipeline=~\"$pipeline\"}[1m])",
          "legendFormat": "source poll {{connector}}",
          "refId": "A"
        },
        {
          "expr": "rate(kafka_connect_sink_task_sink_record_read_total{pipeline=~\"$pipeline\"}[1m])",
          "legendFormat": "sink read {{connector}}",
          "refId": "B"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 6,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "title": "Scrape Targets Up",
      "targets": [
        {
          "expr": "up{pipeline=~\"$pipeline\"}",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "원천 DB 가 실제로 처리한 TPS. k6 가 보낸 목표 TPS 가 아니라 이 값이 파이프라인 입력의 정답이다.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "id": 7,
      "title": "Postgres Commit Rate (actual TPS)",
      "targets": [
        {
          "expr": "rate(pg_stat_database_xact_commit{datname!~\"template.*|postgres\", pipeline=~\"$pipeline\"}[1m])",
          "legendFormat": "commit {{datname}}",
          "refId": "A"
        },
        {
          "expr": "rate(pg_stat_database_xact_rollback{datname!~\"template.*|postgres\", pipeline=~\"$pipeline\"}[1m])",
          "legendFormat": "rollback {{datname}}",
          "refId": "B"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "CDC 가 캡처해야 할 행 변경량. Debezium source record rate 와 이 값이 벌어지면 캡처가 밀리고 있다는 뜻이다.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "id": 8,
      "title": "Postgres Row Change Rate (insert/update/delete)",
      "targets": [
        {
          "expr": "rate(pg_stat_database_tup_inserted{datname!~\"template.*|postgres\", pipeline=~\"$pipeline\"}[1m])",
          "legendFormat": "inserted",
          "refId": "A"
        },
        {
          "expr": "rate(pg_stat_database_tup_updated{datname!~\"template.*|postgres\", pipeline=~\"$pipeline\"}[1m])",
          "legendFormat": "updated",
          "refId": "B"
        },
        {
          "expr": "rate(pg_stat_database_tup_deleted{datname!~\"template.*|postgres\", pipeline=~\"$pipeline\"}[1m])",
          "legendFormat": "deleted",
          "refId": "C"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "VU 100 개가 max_connections 에 닿는지 확인한다. 상한에 붙으면 k6 쪽에서 연결 오류가 난다.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "id": 9,
      "title": "Postgres Connections vs max_connections",
      "targets": [
        {
          "expr": "sum(pg_stat_database_numbackends{datname!~\"template.*|postgres\", pipeline=~\"$pipeline\"})",
          "legendFormat": "backends",
          "refId": "A"
        },
        {
          "expr": "pg_settings_max_connections{pipeline=~\"$pipeline\"}",
          "legendFormat": "max_connections",
          "refId": "B"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Debezium 을 kill 한 동안 복제 슬롯이 붙잡고 있는 WAL. max_slot_wal_keep_size 에 닿으면 슬롯이 invalidated 되고 CDC 재개가 불가능해진다.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "id": 10,
      "title": "Replication Slot Retained WAL",
      "targets": [
        {
          "expr": "pg_replication_slot_current_wal_lsn{pipeline=~\"$pipeline\"} - pg_replication_slot_confirmed_flush_lsn{pipeline=~\"$pipeline\"}",
          "legendFormat": "retained {{slot_name}}",
          "refId": "A"
        },
        {
          "expr": "pg_replication_slot_is_active{pipeline=~\"$pipeline\"}",
          "legendFormat": "active {{slot_name}}",
          "refId": "B"
        }
      ],
      "type": "timeseries"
    }
  ],
  "schemaVersion": 39,
  "tags": ["pp", "kafka", "connect"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(up, pipeline)",
        "includeAll": true,
        "label": "pipeline",
        "multi": true,
        "name": "pipeline",
        "query": { "query": "label_values(up, pipeline)", "refId": "GrafanaVariableQueryEditor-VariableQuery" },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "PP Pipeline (ALO/EOS)",
  "uid": "pp-pipeline",
  "version": 1,
  "weekStart": ""
}
